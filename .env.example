# ─────────────────────────────────────────────────────────────
#  بلند بگو — تنظیمات
#  این فایل را کپی کن و اسمش را بگذار  .env
# ─────────────────────────────────────────────────────────────

# کدام موتور؟
#   mock       = بدون کلید، با مکالمه‌های از پیش نوشته‌شده (پیش‌فرض)
#   claude     = Claude Opus 5، نیاز به کلید Anthropic دارد (پولی)
#   openrouter = یک مدل رایگان («:free») روی OpenRouter، نیاز به کلید OpenRouter دارد (رایگان)
ENGINE=mock

# کلید API از console.anthropic.com — فقط وقتی ENGINE=claude لازم است.
ANTHROPIC_API_KEY=

# کلید API رایگان از https://openrouter.ai/keys (بدون کارت بانکی) —
# فقط وقتی ENGINE=openrouter لازم است.
OPENROUTER_API_KEY=
# مدل رایگان پیش‌فرض. اگر این مدل دیگر در فهرست رایگان‌ها نبود، از
# https://openrouter.ai/models?max_price=0 یکی دیگر را جایگزین کن.
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# پورت سرور
PORT=5173
