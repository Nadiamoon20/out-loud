# ─────────────────────────────────────────────────────────────
#  بلند بگو — تنظیمات
#  این فایل را کپی کن و اسمش را بگذار  .env
# ─────────────────────────────────────────────────────────────

# کدام موتور؟
#   mock   = بدون کلید، با مکالمه‌های از پیش نوشته‌شده (پیش‌فرض)
#   claude = مدل واقعی، نیاز به کلید API دارد
ENGINE=mock

# کلید API از console.anthropic.com
# تا وقتی ENGINE=mock است، این خط لازم نیست.
ANTHROPIC_API_KEY=

# پورت سرور
PORT=5173
